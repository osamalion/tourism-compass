{
  "name": "tourism-compass",
  "version": "30.0.0",
  "private": true,
  "description": "Tourism Compass - responsive HTML, CSS, JavaScript and Firebase web app",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "start": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "firebase:login": "firebase login",
    "firebase:deploy": "npm run build && firebase deploy --only firestore:rules,hosting",
    "firebase:rules": "firebase deploy --only firestore:rules"
  },
  "devDependencies": {
    "vite": "latest"
  }
}
